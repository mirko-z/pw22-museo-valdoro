# Copiare questo file in ".env" e modificare i valori.
# Il file .env contiene segreti: è escluso da Git (.gitignore) e non va mai pubblicato.

# Ambiente: development | production | test
# In production il cookie del token ha il flag Secure (richiede HTTPS).
APP_ENV=development

# Porta dell'host su cui risponde nginx (http://localhost:8080)
WEB_PORT=8080

# Database PostgreSQL
POSTGRES_USER=museo
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=museo
# Nei container vale "db" (impostato da docker-compose.yml);
# per eseguire il back-end o i test fuori da Docker usare "localhost".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Segreto per la firma HS256 dei JWT: almeno 32 caratteri casuali.
# Per generarlo:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=sostituire-con-un-valore-casuale-di-almeno-32-caratteri
JWT_EXPIRE_MINUTES=60

# Regole di prenotazione di default, usate quando lo staff non le indica per l'evento
DEFAULT_MAX_SEATS_PER_BOOKING=6
DEFAULT_CANCELLATION_DEADLINE_HOURS=24

# Dati di esempio fittizi caricati all'avvio, solo se il database è vuoto
# (mai in production). Account: admin@museovaldoro.example, staff@museovaldoro.example,
# visitatori *@example.com; tutti con la password qui sotto.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Valdoro-Demo-2026

# Numero di processi worker di Uvicorn (parallelismo su più core)
API_WORKERS=1
